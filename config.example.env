# Copy to .env and fill in locally. Never commit real secrets.

# Paths (relative to project root unless absolute)
OUTREACH_DB_PATH=storage/outreach.db
INCOMING_CSV_DIR=data/incoming
EXPORTS_DIR=data/exports
ORIGINALS_DIR=data/originals
LOGS_DIR=logs

# Campaign defaults
DEFAULT_NICHE=restaurants
DEFAULT_LOCATION=Sweden

# Sending (live send stays off until you explicitly enable it)
SEND_MODE=mock
GLOBAL_DAILY_SEND_CAP=30
ACCOUNT_DAILY_SEND_CAP=15
SENDER_POLICY=round_robin
SENDER_A_EMAIL=hassansfida@gmail.com
SENDER_B_EMAIL=hassans.official1@gmail.com
SEND_PACING_SECONDS_MIN=45
SEND_PACING_SECONDS_MAX=120

# Gmail OAuth (leave empty until setup; never put real secrets here)
GMAIL_A_CLIENT_ID=
GMAIL_A_CLIENT_SECRET=
GMAIL_A_TOKEN_PATH=storage/gmail_a_token.json
GMAIL_B_CLIENT_ID=
GMAIL_B_CLIENT_SECRET=
GMAIL_B_TOKEN_PATH=storage/gmail_b_token.json

# Local AI (Phase later; unused in Phase 1)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# Playwright research (Phase later)
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_MOBILE_WIDTH=390
PLAYWRIGHT_MOBILE_HEIGHT=844
